# RVR — Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── AI providers ────────────────────────────────────────────────
# Set whichever key(s) you have — with AI_PROVIDER unset (or "auto"),
# RVR picks the first available in order: Gemini, Groq, Claude, OpenAI.
# Force a choice with AI_PROVIDER=gemini|groq|claude|openai, and override
# the model with AI_MODEL=<model-name>.

# Gemini — free tier: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — free tier, no credit card: https://console.groq.com/keys
#GROQ_API_KEY=your_groq_api_key_here

# Claude — https://console.anthropic.com
#ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — https://platform.openai.com
#OPENAI_API_KEY=your_openai_api_key_here

#AI_PROVIDER=auto
#AI_MODEL=

# ── Discord notifications ───────────────────────────────────────
# Scan-complete summary posted as rich multi-embed message.
# Create one in your Discord server: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
