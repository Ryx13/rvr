# RVR — Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to git

# Gemini API key — get yours free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Discord webhook URL for scan notifications
# Create one in your Discord server: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
